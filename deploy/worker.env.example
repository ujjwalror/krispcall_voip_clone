# ==============================================================================
# TELECOM WORKER HOST ENVIRONMENT CONFIGURATION TEMPLATE
# Do NOT place real secrets in this template or commit production secrets to Git.
# Store production file outside repository (e.g. /etc/voip-hub/worker.env, chmod 600).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. COMMON DATABASE CREDENTIALS (REQUIRED FOR ALL WORKERS)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_service_role_secret_key_here

# ------------------------------------------------------------------------------
# 2. WORKER POLLING INTERVALS IN MILLISECONDS (OPTIONAL - DEFAULTS SET IN CODE)
# ------------------------------------------------------------------------------
TELECOM_VOICE_EXTENSION_WORKER_POLL_INTERVAL_MS=3000
TELECOM_RECONCILIATION_WORKER_POLL_INTERVAL_MS=5000
TELECOM_TERMINATION_WORKER_POLL_INTERVAL_MS=4000

# ------------------------------------------------------------------------------
# 3. SAFETY CONTROL FLAGS & ENFORCEMENT MODES (KEEP OFF FOR INITIAL DEPLOYMENT)
# ------------------------------------------------------------------------------
# Default is shadow_log. Do NOT set to enforce until readiness checklist passes.
TELECOM_PREPAID_ENFORCEMENT_MODE=shadow_log

# Master Provider Mutation Gate (Default: false / OFF)
# Must remain false during Stage B worker startup verification.
TELECOM_ACTIVE_CALL_PROVIDER_MUTATIONS_ENABLED=false

# Scoped Provider Mutation Gates (Default: false / OFF)
TELECOM_EXPERIMENT_SCOPE_EXTEND_ALLOWANCE=false
TELECOM_EXPERIMENT_SCOPE_TERMINATE_CALL=false

# ------------------------------------------------------------------------------
# 4. TWILIO PROVIDER CREDENTIALS (REQUIRED ONLY WHEN MUTATIONS ARE AUTHORIZED)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_API_KEY_SID=your_twilio_api_key_sid
TWILIO_API_KEY_SECRET=your_twilio_api_key_secret
TWILIO_TWIML_APP_SID=your_twilio_twiml_app_sid
TWILIO_PHONE_NUMBER=+10000000000
